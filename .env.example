# Admin panelə giriş şifrəsi (ən azı 12 simvol). Production-da mütləqdir.
ADMIN_PASSWORD=
# Sessiya imzası üçün gizli açar (ən azı 32 simvol, təsadüfi).
SESSION_SECRET=
# İstəyə görə: əlaqə formundan gələn mesajlar bu ünvana POST olunur (məsələn n8n webhook).
CONTACT_WEBHOOK_URL=
# İstəyə görə: məlumat qovluğu (default: ./data). Docker/VPS-də volume qoşun.
DATA_DIR=
